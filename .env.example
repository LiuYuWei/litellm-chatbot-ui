# ===== LiteLLM 連線設定 =====
# LiteLLM Proxy 的位址（不含 /v1）
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM 的 API Key（sk-...）；若你的 Proxy 未啟用驗證可留空
LITELLM_API_KEY=
# 呼叫 LiteLLM 的逾時秒數
LITELLM_TIMEOUT=120

# ===== 模型設定 =====
# 預設使用的模型，請填入 LiteLLM 上實際存在的模型名稱
DEFAULT_MODEL=gpt-4o-mini
# 可用模型白名單（逗號分隔）；留空則直接採用 LiteLLM /v1/models 回傳的清單
ALLOWED_MODELS=

# ===== 登入設定 =====
# 允許登入的帳號密碼，格式為 帳號:密碼，多組以逗號分隔
AUTH_USERS=admin:admin1234,demo:demo1234
# JWT 簽章金鑰，正式環境請務必改成隨機字串（可用 make secret 產生）
JWT_SECRET=please-change-this-secret-in-production
# 登入有效時間（分鐘），預設 12 小時
JWT_EXPIRE_MINUTES=720

# ===== 伺服器設定 =====
# 對外開放的埠號（docker compose 使用）
APP_PORT=8000
# 允許的 CORS 來源，多個以逗號分隔；* 代表全部
CORS_ORIGINS=*
# 日誌等級：debug / info / warning / error
LOG_LEVEL=info
