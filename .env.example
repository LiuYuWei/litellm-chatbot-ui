# ===== 模型來源設定 =====
# 多來源：JSON 陣列（單行），每個項目代表一個 OpenAI 相容後端（LiteLLM Proxy、vLLM、Ollama…）。
#   id            必填，來源代號，只能用英數字/底線/句點/連字號，會成為模型名稱前綴
#   label         顯示名稱，留空則沿用 id
#   base_url      服務位址，不含 /v1
#   api_key       該來源的 API Key，未啟用驗證可留空
#   timeout       逾時秒數，預設 120
#   allowed_models 該來源的模型白名單（陣列），留空代表採用 /v1/models 的完整清單
# 留空則退回下方的單一 LITELLM_* 設定。
#LLM_PROVIDERS=[{"id":"litellm","label":"LiteLLM Proxy","base_url":"https://litellm.example.com","api_key":"sk-xxxx"},{"id":"vllm","label":"地端 vLLM","base_url":"http://vllm:8000","api_key":""}]

# ===== 單一來源（LLM_PROVIDERS 未設定時使用）=====
# LiteLLM Proxy 的位址（不含 /v1）
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM 的 API Key（sk-...）；若你的 Proxy 未啟用驗證可留空
LITELLM_API_KEY=
# 呼叫 LiteLLM 的逾時秒數
LITELLM_TIMEOUT=120

# ===== 模型設定 =====
# 預設模型。多來源時請填「來源/模型」，例如 vllm/meta-llama/Llama-3.1-8B-Instruct
DEFAULT_MODEL=gpt-4o-mini
# 全域模型白名單（逗號分隔），可寫「來源/模型」或裸模型名稱；留空代表不額外過濾
ALLOWED_MODELS=

# ===== 登入設定 =====
# 允許登入的帳號密碼，格式為 帳號:密碼，多組以逗號分隔
AUTH_USERS=admin:admin1234,demo:demo1234
# JWT 簽章金鑰，正式環境請務必改成隨機字串（可用 make secret 產生）
JWT_SECRET=please-change-this-secret-in-production
# 登入有效時間（分鐘），預設 12 小時
JWT_EXPIRE_MINUTES=720

# ===== 伺服器設定 =====
# 對外開放的埠號（docker compose 使用）
APP_PORT=8000
# 允許的 CORS 來源，多個以逗號分隔；* 代表全部
CORS_ORIGINS=*
# 日誌等級：debug / info / warning / error
LOG_LEVEL=info
